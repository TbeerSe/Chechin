<?xml version="1.0" encoding="utf-8"?>
<!-- API <= 30: nothing goes to the cloud backup. Every data domain is excluded explicitly:
     "root" alone does not cover files / shared preferences / databases, which live in their own domains.
     See data_extraction_rules.xml for device-to-device transfer. -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
